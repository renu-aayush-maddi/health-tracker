# Copy to `.env` in the repo root for local development. Never commit real values.
# In production (Render), set these as environment variables on the web service instead.

# ---- Backend ----
NODE_ENV=development
PORT=4000
# Local: postgres://localhost:5432/health_tracker_dev
# Production: the Supabase *session pooler* connection string (IPv4), e.g.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://localhost:5432/health_tracker_dev
# Supabase CA certificate (PEM). In a single-line env var, newlines may be written as \n.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
# Database used by `npm test` (NODE_ENV=test). Must be a disposable local database.
TEST_DATABASE_URL=postgres://localhost:5432/health_tracker_test
# Public URL of the frontend. Used for the CSRF Origin check and password-reset links.
APP_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally; set on Render after verifying).
TRUST_PROXY=0
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# console = print emails to the server log (dev).
# brevo / resend = send over HTTPS using MAIL_API_KEY. Required on hosts that block SMTP ports
#   (Render free instances block 25/465/587), and generally more reliable.
# smtp = send through SMTP_URL (works locally and on paid hosts).
MAIL_PROVIDER=console
# API key for MAIL_PROVIDER=brevo or resend. Never commit it.
MAIL_API_KEY=
MAIL_FROM="Health Tracker <no-reply@example.com>"
SMTP_URL=
# Local only: turns off rate limiting so end-to-end tests can register many users.
# Refused in production.
DISABLE_RATE_LIMITS=false

# ---- File attachments (optional medical records) ----
# From the Cloudinary console: cloudinary://<api_key>:<api_secret>@<cloud_name>. Leave empty to
# disable uploads. Never commit this value.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=health-tracker

# ---- Encrypted nightly backups (see README → Backups) ----
# 32 random bytes, base64: `openssl rand -base64 32`. Keep a safe copy OUTSIDE this server:
# without it, backups cannot be decrypted. Never commit it.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION=14

# ---- Frontend (exposed to the browser: never put secrets in VITE_* variables) ----
VITE_API_BASE_URL=/api
