{
  "name": "@health-tracker/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node --env-file-if-exists=../.env src/backup/runBackup.js",
    "backup:list": "node --env-file-if-exists=../.env src/backup/cli.js list",
    "backup:fetch": "node --env-file-if-exists=../.env src/backup/cli.js fetch",
    "backup:decrypt": "node --env-file-if-exists=../.env src/backup/cli.js decrypt"
  },
  "dependencies": {
    "@health-tracker/shared": "^1.0.0",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
